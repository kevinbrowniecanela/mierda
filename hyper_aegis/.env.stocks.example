# =====================================================================
# HyperAegis — MODO ACCIONES DE EE. UU. (solo simulación)
# Copia a .env.stocks y arranca con:  ENV_FILE=.env.stocks python run.py
# Estado, ledger y panel separados de la instancia de cripto.
# =====================================================================
MARKET=stocks
TRADING_MODE=paper            # live NO está soportado en acciones (sin broker integrado)
ALLOW_SHORT=false             # los cortos pierden en acciones: desactivados

# Capital simulado: 200 EUR ~ 224 USD
INITIAL_CAPITAL=224
RISK_PER_TRADE_PCT=0.01
RISK_BASIS=equity
MAX_OPEN_POSITIONS=5
MAX_LEVERAGE=1                # cuenta al contado, sin apalancamiento
MIN_ORDER_USD=1
TAKER_FEE_RATE=0              # sin comisión; el deslizamiento simulado es de 5 pb

# Sistema diario: solo estrategias de tendencia (largos)
STRATEGIES=["donchian55_tendencia","squeeze_breakout","donchian20_tendencia"]
CANDLE_INTERVAL=1d
SCAN_INTERVAL_SEC=900
POSITION_CHECK_INTERVAL_SEC=60
WATCHLIST_REFRESH_SEC=21600
STOCK_WATCHLIST_SIZE=40
EXIT_MODE=chandelier
DEFAULT_STOP_ATR_MULT=2.0
TRAILING_ATR_MULT=3.0

# Claude supervisa y puede vetar (opcional)
ANTHROPIC_API_KEY=
CLAUDE_ENABLED=true
CLAUDE_MODEL=claude-sonnet-5-5

# Estado separado de la instancia de cripto
STATE_DIR=state_stocks
LOG_DIR=logs_stocks
TAX_LEDGER_PATH=tax_ledger_stocks.csv
DASHBOARD_PORT=8788

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
