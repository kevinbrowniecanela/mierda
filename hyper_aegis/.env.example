# =====================================================================
# HyperAegis — copia este archivo a .env y rellena los valores.
# NUNCA subas .env a git.
# =====================================================================

# --- Modo -------------------------------------------------------------
TRADING_MODE=paper          # paper | live
USE_TESTNET=false           # true para operar contra la testnet de Hyperliquid

# --- Hyperliquid (Agent Wallet) ----------------------------------------
# Crea una "API Wallet" en app.hyperliquid.xyz -> More -> API. Esa clave
# solo puede firmar órdenes: NO puede retirar fondos.
HL_AGENT_PRIVATE_KEY=0x...
# Dirección pública de tu cuenta principal (la que tiene los USDC)
HL_ACCOUNT_ADDRESS=0x...

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# claude-3-5-sonnet está retirado; claude-sonnet-5-5 es su sucesor directo.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=high
CLAUDE_ENABLED=true          # Claude supervisa y puede vetar cada señal
CLAUDE_REQUIRED=false        # true: si Claude no responde, no se opera
CLAUDE_ENABLE_FALLBACKS=true

# --- Noticias ----------------------------------------------------------
CRYPTOPANIC_API_KEY=
# RSS_FEEDS='["https://www.coindesk.com/arc/outboundfeeds/rss/","https://www.theblock.co/rss.xml"]'

# --- Telegram ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Riesgo / Capital Shield --------------------------------------------
INITIAL_CAPITAL=224          # USDC depositados (~200 EUR)
RISK_PER_TRADE_PCT=0.01
RISK_BASIS=equity            # equity (interés compuesto) | initial
EXIT_MODE=chandelier         # chandelier (trailing ATR) | tp_partial (TP1 50 % + breakeven)
DEFAULT_STOP_ATR_MULT=2.0
TRAILING_ATR_MULT=3.0
HOUSE_MONEY_TRIGGER_PCT=0.15
MAX_OPEN_POSITIONS=3
DAILY_DRAWDOWN_LIMIT_PCT=0.03
FLATTEN_ON_CIRCUIT_BREAKER=true
MAX_LEVERAGE=5

# --- Señales (velas diarias) ---------------------------------------------
CANDLE_INTERVAL=1d
SCAN_INTERVAL_SEC=900
MAX_CLAUDE_CALLS_PER_HOUR=12

# --- Vigilante y panel ---------------------------------------------------
WATCHDOG_LEAK_PCT=0.05
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8787

# --- Fiscalidad ---------------------------------------------------------
FX_API_URL=https://api.frankfurter.dev/v1
LOG_LEVEL=INFO
